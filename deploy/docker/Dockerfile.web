# 階段 1: 編譯前端
FROM node:20-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm@12.14.0

COPY package.json pnpm-workspace.yaml tsconfig.json .npmrc ./
COPY packages/astro-core/package.json ./packages/astro-core/
COPY apps/web/package.json ./apps/web/

RUN pnpm approve-builds --all && pnpm install

COPY packages/astro-core ./packages/astro-core
COPY apps/web ./apps/web

WORKDIR /app/packages/astro-core
RUN pnpm build

WORKDIR /app/apps/web
RUN pnpm build

# 階段 2: Nginx 輕量靜態服務
FROM nginx:alpine AS runner
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
