# ===============================================
# 萬象天儀 (Astraea & CelestialDao) 環境變數範本
# ===============================================

PORT=5498
HOST=0.0.0.0
NODE_ENV=production

# 資料庫連線字串 (預設使用 SQLite，亦可配置 PostgreSQL: postgresql://user:pass@host:5432/dbname?schema=public)
DATABASE_URL="file:./packages/database/prisma/dev.db"

# JWT 簽發金鑰 (生產環境請務必更換為高強度隨機字串，至少32位元)
JWT_SECRET="celestial_jwt_super_secret_key_change_me_2026"

# 允許跨域請求來源 (生產環境請指定具體網域，如 https://yourdomain.com)
CORS_ORIGIN="*"

# DEMO 模式開關 (預設嚴格關閉 false，僅在內部展示時開啟 true)
DEMO_MODE=false
VITE_DEMO_MODE=false
