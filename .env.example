# ===============================================
# 萬象天儀 (Astraea & CelestialDao) 環境變數範本
# ===============================================

PORT=9998
HOST=0.0.0.0
NODE_ENV=production

# 資料庫連線字串 (預設使用 SQLite，亦可配置 PostgreSQL: postgresql://user:pass@host:5432/dbname?schema=public)
DATABASE_URL="file:/home/coder/Codebase/Horoscope/packages/database/prisma/dev.db"

# JWT 簽發金鑰 (生產環境請更換為高強度隨機字串)
JWT_SECRET="celestial_jwt_super_secret_key_change_me_2026"

# 允許跨域請求來源 (* 代表允許所有 IP 與網域訪問)
CORS_ORIGIN="*"

# DEMO 模式開關 (true: 允許訪客免登入體驗全功能與後台; false: 關閉 DEMO 模式，強制會員真實認證登入)
DEMO_MODE=true
VITE_DEMO_MODE=true
