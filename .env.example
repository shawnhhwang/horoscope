# ===============================================
# 萬象天儀 (Astraea & CelestialDao) 環境變數範本
# ===============================================

PORT=5498
HOST=0.0.0.0
NODE_ENV=production

# 資料庫連線字串 (預設使用 SQLite，亦可配置 PostgreSQL: postgresql://user:pass@host:5432/dbname?schema=public)
DATABASE_URL="file:./packages/database/prisma/dev.db"

# JWT 簽發金鑰 (生產環境請務必更換為高強度隨機字串，至少32位元)
JWT_SECRET="celestial_jwt_super_secret_key_change_me_2026"

# 允許跨域請求來源 (生產環境請指定具體網域，如 https://yourdomain.com)
CORS_ORIGIN="*"

# DEMO 模式開關 (預設嚴格關閉 false，僅在內部展示時開啟 true)
DEMO_MODE=false
VITE_DEMO_MODE=false

# LLM 金鑰 AES-256-GCM 加密主密鑰 (生產環境請務必設定獨立 32 字元以上隨機字串)
LLM_ENCRYPTION_KEY="change_me_to_32_char_random_encryption_key"

# SSRF 防護內網放行清單 (選填，僅當使用區域網自建 Ollama/vLLM 時填入，如 192.168.1.3)
LLM_ALLOW_PRIVATE_HOSTS=""

# 後台資料庫管理寫入開關 (預設唯讀鎖定 false；設為 true 並通過二次確認始可寫入)
ADMIN_DB_WRITE_ENABLED=false

# Redis 快取與限流連線字串 (選填，未設定時自動降級為單機記憶體快取)
REDIS_URL=""
